        {
          "id": "e782319a-fa89-47e3-86c8-da848a42f36d",
          "name": "Query Receipt Data",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "$",
            "query": "query($receiptIds: [String!]!){\r\n  receipt(\r\n    where:  {\r\n       id:{\r\n        _in: $receiptIds\r\n       }\r\n    }\r\n  ){\r\n    edges{\r\n      node{\r\n        id\r\n        receiptLines{\r\n          edges{\r\n            node{\r\n              receiptStatusId\r\n              _aggregate{\r\n                receiptStatusId{\r\n                  count\r\n                }\r\n              }\r\n            }\r\n          }\r\n        }\r\n      }\r\n    }\r\n  }\r\n}",
            "nextNodes": [
              "5dc1e02e-76a5-4c4e-9872-d080ba5ca007"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "c15d936d-97d5-480a-88c3-c31897917057",
          "name": "Prepare Payload",
          "type": "transform",
          "data": {
            "transform": "receipt.edges.node.{\r\n    \"where\":{ \"id\": id},\r\n    \"update\":{\r\n      \"receiptStatusId\": $all(\r\n        [receiptLines.edges.node.receiptStatusId], \r\n        function($v){$v = \"confirmed\"})? \"confirmed\" : \"pendingConfirmation\"\r\n    }\r\n  }\r\n",
            "nextNodes": [
              "db9fbf87-0def-40ec-86f1-1023b94c97ec"
            ]
          },
          "debug": {

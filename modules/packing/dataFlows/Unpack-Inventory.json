        {
          "id": "248151fe-163c-4256-a922-f233c632ebf1",
          "name": "Query Serial and Line",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "{\r\n  \"where\":{\r\n    \"_or\": [\r\n      {\r\n        \"id\": { \"_eq\": REQUEST.id },\r\n        \"inventoryStatusId\":{ \"_eq\": packed\" }\r\n      },\r\n      {\r\n        \"handlingUnitId\": { \"_eq\": REQUEST.id },\r\n        \"inventoryStatusId\":{ \"_eq\": packed\" }\r\n      }\r\n    ]\r\n  },\r\n  \"shipmentLineWhere\":{\r\n    \"id\":{\r\n      '_eq': REQUEST.shipmentLineId\r\n    }\r\n  }\r\n}",
            "query": "query Inventory(\n  $where: InventoryWhereInput,\n  $shipmentLineWhere: ShipmentLineWhereInput\n) {\n  inventory(where: $where){\n    edges{\n      node{\n        id\n        serialNumber\n        handlingUnitId\n        inventoryStatusId\n        quantity{ value }\n      }\n    }\n  }\n\n  shipmentLine(where: $shipmentLineWhere ){\n    edges{\n      node{\n        inventories{\n          edges{\n            node{\n              quantity{\n                _aggregate{\n                  value{\n                    sum\n                  }\n                }\n              }\n            }\n          }\n        }\n      }\n    }\n  }\n}",
            "nextNodes": [
              "77a4bf78-e03d-4b69-b1d0-a335b359b7b7"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "77a4bf78-e03d-4b69-b1d0-a335b359b7b7",
          "name": "Prepare Payload",
          "type": "transform",
          "data": {
            "nextNodes": [
              "27610ed3-e784-4cb9-85fa-aab60bd3d345"
            ],
            "transform": "(\r\n  $quantityToRemove := $sum(inventory.edges.node.quantity.value);\r\n  $newQuantity := shipmentLine.edges.node.inventories.edges.node.quantity._aggregate.value.sum - $quantityToRemove; \r\n  \r\n  {\r\n    \"shipmentLinePayload\":[\r\n      {\r\n        \"where\":{ \"id\": $state.context.INPUT.REQUEST.shipmentLineId },\r\n        \"update\":{\r\n          \"quantity\":{ \"value\": $newQuantity}\r\n        }\r\n      }\r\n    ],\r\n    \"inventoryPayload\":[\r\n      inventory.edges.node.{\r\n        \"where\":{ \"id\": id},\r\n        \"update\":{\r\n          \"shipmentLineId\": null,\r\n          /* \"inventoryStatusId\": \"ok\", */\r\n          \"handlingUnitId\": null\r\n        }\r\n      }\r\n    ]\r\n  } \r\n)"
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,

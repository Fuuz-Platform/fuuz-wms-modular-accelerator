            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "27610ed3-e784-4cb9-85fa-aab60bd3d345",
          "name": "Mutate Inventory and Line",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "$",
            "nextNodes": [
              "b4394710-ff2b-47b3-afb3-1e5e2a3ecc03"
            ],
            "mutation": "mutation ( \r\n  $shipmentLinePayload: [ShipmentLineUpdatePayloadInput!]!,\r\n  $inventoryPayload: [InventoryUpdatePayloadInput!]!\r\n){\r\n  updateShipmentLine(payload:  $shipmentLinePayload){ id }\r\n  updateInventory(payload:  $inventoryPayload ) { id }\r\n}"
          },

                "isCanvas": false,
                "props": {
                  "margin": 6,
                  "buttonColor": "primary",
                  "width": "96px",
                  "height": "48px",
                  "disabled": {
                    "__transform": "$not($components.Form1.formState.valid)",
                    "__dynamicFields": {
                      "payload": [],
                      "context": [
                        "components.Form1.formState.valid"
                      ]
                    },
                    "__cacheKey": "FormStateIsNotValid",
                    "__remote": false,
                    "__fallbackValue": true
                  },
                  "hidden": false,
                  "useIconButton": false,
                  "disableHover": false,
                  "disableRipple": false,
                  "action": [
                    {
                      "type": "query",
                      "query": "query InventoryPickStep($where: InventoryPickStepWhereInput, $orderBy: [InventoryPickStepOrderByInput!], $first: Int, $after: String) {\n  inventoryPickStep(\n    where: $where\n    orderBy: $orderBy\n    first: $first\n    after: $after\n  ) {\n    edges {\n      node {\n        id\n      }\n    }\n  }\n}",
                      "api": "Application",
                      "transforms": {
                        "pre": "{\r\n  \"where\":{\r\n    \"pickStepId\":{\r\n      \"_eq\": $metadata.urlParameters.pickStepId\r\n    },\r\n    \"_or\": [\r\n      {\r\n        \"inventoryId\":{\r\n          \"_eq\": $metadata.urlParameters.inventoryId\r\n        }\r\n      },\r\n      {\r\n        \"inventory\":{\r\n          \"handlingUnitId\":{\r\n            \"_eq\": $metadata.urlParameters.inventoryId\r\n          }\r\n        }\r\n      }\r\n    ]\r\n  }\r\n}"
                      }
                    },
                    {
                      "type": "mutation",
                      "api": "Application",
                      "mutation": "mutation UpdateInventoryPickStep($payload: [InventoryPickStepUpdatePayloadInput!]!) {\n  updateInventoryPickStep(payload: $payload) {\n    id\n  }\n}",
                      "transforms": {
                        "pre": "{\r\n  \"payload\": [\r\n    {\r\n      \"update\": {\r\n        \"picked\": false\r\n      },\r\n      \"where\": {\r\n        \"id\": data.inventoryPickStep.edges.node.id\r\n      }\r\n    }\r\n  ]\r\n}"
                      }
                    },
                    {
                      "type": "mutation",
                      "api": "Application",
                      "mutation": "mutation CreateUnpick($payload: [UnpickCreatePayloadInput!]!) {\n  createUnpick(payload: $payload) {\n    id\n  }\n}",
                      "transforms": {
                        "pre": "{\r\n  \"payload\": [\r\n    {\r\n      \"create\": {\r\n        \"userId\": $metadata.user.id,\r\n        \"unpickReasonId\": $components.Form1.data.unpickReason.id,\r\n        \"note\": $components.Form1.data.note\r\n      }\r\n    }\r\n  ]\r\n}"
                      }
                    },
                    {
                      "type": "message",
                      "title": "Success!",
                      "message": "Inventory successfully unpicked!",
                      "severity": "info",
                      "transforms": {
                        "post": "$components.Screen.fn.return({\r\n  \"success\": true,\r\n  \"inventoryId\": $metadata.urlParameters.inventoryId\r\n})"
                      }
                    }
                  ],
                  "icon": {

                "props": {
                  "query": {
                    "api": "Application",
                    "query": "query (\n  $countId: String!,\n  $storageUnitCode: String\n  $first: Int\n){\n  countLine(\n    first: $first\n    where:{\n      countId: {\n        _eq: $countId \n      }\n      expectedStorageUnit:  {\n         code:  {\n            _contains: $storageUnitCode\n         }\n      }\n    }\n  ){\n    total\n    edges{\n      node{\n        id\n        expectedStorageUnit{\n          id\n          code\n        }\n        _aggregate{\n          expectedStorageUnitId{\n            uniqueValues\n          }\n        }\n      }\n    }\n  }\n\n  countLineInventory(\n    first: $first\n    where:{\n      countLine:  {\n        countId: {\n          _eq: $countId \n        }\n        expectedStorageUnit:  {\n         code:  {\n            _contains: $storageUnitCode\n         }\n        }   \n      }\n      \n    }\n  ){\n    total\n    edges{\n      node{\n        id\n        countLine{\n          expectedStorageUnitId\n        }\n        quantity{\n          _aggregate{\n            value{\n              sum\n            }\n          }\n        }\n\n      }\n    }\n  }\n\n  counted: countLineInventory(\n    first: $first\n    where:{\n      counterUserId:  {\n         _isNull: false\n      }\n      countLine:  {\n        countId: {\n          _eq: $countId \n        }\n        expectedStorageUnit:  {\n          code:  {\n              _contains: $storageUnitCode\n          }\n        }   \n      }\n      \n    }\n  ){\n    total\n    edges{\n      node{\n        id\n        countLine{\n          expectedStorageUnitId\n        }\n        quantity{\n          _aggregate{\n            value{\n              sum\n            }\n          }\n        }\n\n      }\n    }\n  }\n\n  storageUnit(\n    first: $first\n    where:  {\n       code:  {\n          _contains: $storageUnitCode\n       }\n    }\n  ){\n    edges{\n      node{\n        code id\n      }\n    }\n  }\n}",
                    "dataPath": "",
                    "dataTransform": {
                      "transform": "(\r\n  $expectedLocations := [$leftOuterJoin( \r\n    [countLine.edges.node], \r\n    [countLineInventory.edges.node], \r\n    'expectedStorageUnit.id', \r\n    'countLine.expectedStorageUnitId', \r\n    'total'\r\n  )\r\n  ~>$leftOuterJoin( \r\n    [counted.edges.node], \r\n    'expectedStorageUnit.id', \r\n    'countLine.expectedStorageUnitId', \r\n    'counted'\r\n  )\r\n  ~>| $ | { \r\n    \"totalQuantity\": total.quantity._aggregate.value.sum, \r\n    \"countedQuantity\": $coalesce([ counted.quantity._aggregate.value.sum, 0])  \r\n  } |];\r\n  \r\n\r\n)",
                      "remote": true
                    },
                    "dataSubscription": {
                      "enabled": false
                    },
                    "autoLoad": true,
                    "parameters": "/*\n* These Cards use a custom Query\n*/\n{\n  \"countId\": id,\n  \"storageUnitCode\": $coalesce([$components.Form1.data.storageUnitCode, \"\"]),\n  \"first\": 10\n}",

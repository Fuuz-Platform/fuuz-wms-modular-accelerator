        {
          "id": "2f80e316-80ba-42af-91ac-c5e6313485b9",
          "name": "Mutate",
          "type": "mutate",
          "data": {
            "api": "Application",
            "variablesTransform": "$",
            "mutation": "mutation (\r\n  $inventoryPayload: [InventoryUpdatePayloadInput!]!\r\n  $countLineInventoryPayload: [CountLineInventoryUpdatePayloadInput!]!\r\n  $countPayload: [CountUpdatePayloadInput!]!\r\n) {\r\n  updateInventory(payload: $inventoryPayload) { id }\r\n  updateCountLineInventory(payload: $countLineInventoryPayload) { id }\r\n  updateCount(payload: $countPayload) { id }\r\n}",

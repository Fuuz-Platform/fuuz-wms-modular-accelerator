        {
          "id": "d66f3be4-0537-42ce-b026-e982979b745b",
          "name": "Query Count Inventory",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "    {\r\n      \"where\":{\r\n        \"countLine\":{\r\n          \"countId\":{\r\n            \"_eq\": countId\r\n          }\r\n        }\r\n      }\r\n    }",
            "query": "query CountLineInventory($where: CountLineInventoryWhereInput, $orderBy: [CountLineInventoryOrderByInput!], $first: Int, $after: String) {\n  countLineInventory(\n    where: $where\n    orderBy: $orderBy\n    first: $first\n    after: $after\n  ){\n    edges{\n      node{\n        id\n        inventoryId\n        counterUserId\n        quantity{\n          value unitId\n        }\n        weight{\n          value unitId\n        }\n        storageUnitId\n        inventory{\n          serialNumber\n          storageUnitId\n          quantity{\n            value unitId\n          }\n          grossWeight{\n            value unitId\n          }\n        }\n      }\n    }\n  }\n}",
            "nextNodes": [
              "9c9e997b-049e-4b99-af86-db1823ed53b0"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "9c9e997b-049e-4b99-af86-db1823ed53b0",
          "name": "Prepare Payload",
          "type": "transform",
          "data": {
            "transform": "(\r\n  $currentTime := $now();\r\n  \r\n  $inventoryToUpdate := countLineInventory.edges.node[\r\n    $not(quantity.value = inventory.quantity.value) or\r\n    $not(quantity.unitId = inventory.quantity.unitId) or\r\n    $not(weight.value = inventory.grossWeight.value) or\r\n    $not(weight.unitId = inventory.grossWeight.unitId) or\r\n    $not(storageUnitId = inventory.storageUnitId)\r\n  ].id;\r\n\r\n  $inventoryNotFound := countLineInventory.edges.node[$isNilOrEmpty(counterUserid)];\r\n\r\n $updates := countLineInventory.edges.node.(\r\n      $shouldUpdate := id in $inventoryToUpdate;\r\n      \r\n      {\r\n        \"countLineInventoryPayload\":{\r\n          \"where\":{ \"id\": id },\r\n          \"update\":{\r\n            \"adjustedAt\": $currentTime,\r\n            \"adjustmentId\": $shouldUpdate? \"cycleCounted\" : \"noChange\",\r\n            \"adjustingUserId\": $metadata.user.id\r\n          }          \r\n        },\r\n        \"inventoryPayload\": \r\n          $shouldUpdate? {\r\n            \"where\":{ \"id\": inventoryId },\r\n            \"update\": {\r\n              \"quantity\": quantity,\r\n              \"grossWeight\": weight,\r\n              \"storageUnitId\": storageUnitId,\r\n              \"lastAdjustmentId\": \"cycleCounted\"\r\n            }\r\n          } :\r\n          $isNilOrEmpty(counterUserId)? {\r\n            \"where\":{ \"id\": inventoryId },\r\n            \"update\": {\r\n              \"inventoryStatusId\": \"lost\",\r\n              \"lastAdjustmentId\": \"cycleCounted\"\r\n            }\r\n          }\r\n      }\r\n  );\r\n\r\n  {\r\n    \"countLineInventoryPayload\": [$updates.countLineInventoryPayload],\r\n    \"inventoryPayload\": [$updates.inventoryPayload],\r\n    \"countPayload\":{\r\n      \"where\":{ \"id\": $state.context.INPUT.countId},\r\n      \"update\":{\r\n        \"completedAt\": $currentTime,\r\n        \"countStatusId\": \"COMPLETED\"\r\n\r\n      }\r\n    }\r\n  }\r\n  \r\n)",
            "nextNodes": [
              "2f80e316-80ba-42af-91ac-c5e6313485b9"
            ]
          },
          "debug": {
            "breakpointEnabled": false,
            "publishSubscribeClient": false,
            "publishToMFGx": false
          },
          "logging": {
            "executionMetrics": false,
            "executionStarted": false,
            "executionSucceeded": false,
            "executionFailed": true,
            "enableTraceLogging": false
          }
        },
        {
          "id": "445f24ed-7256-479a-b3fc-69bf75b7636e",
          "name": "Confirm Dialog",
          "type": "confirm",
          "data": {
            "onConfirmNextNodes": [
              "ce5adb06-6673-473b-ad05-de5675f13d3e"
            ],
            "messageTransform": "\"Once the Count is completed all counted adjustments will be applied to the inventory records. This can NOT be undone. Are you sure you would like to complete this Count?\"",
            "titleTransform": "\"Complete Count?\"",
            "onDeclineNextNodes": [
              "a8e26c98-93cd-4f01-9f0a-99966857ee71"
            ]
          },
          "debug": {

        {
          "id": "556fca79-403f-4a8c-bc3a-80bf511c4dd8",
          "name": "Prepare Payload",
          "type": "transform",
          "data": {
            "transform": "orderLineRelease.edges.node.(\r\n  $releaseStatusId := quantityLeft.value = 0 ? \"fulfilled\" :\r\n    quantityLeft.value < quantity.value ? \"partiallyFulfilled\" : \"open\";\r\n\r\n  {\r\n    \"where\": { \"id\": id },\r\n    \"update\": {\r\n      \"orderLineReleaseStatusId\": $releaseStatusId\r\n    }\r\n  }\r\n)",

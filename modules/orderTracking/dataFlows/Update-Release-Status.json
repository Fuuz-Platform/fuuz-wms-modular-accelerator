          "name": "Query Release Data",
          "type": "query",
          "data": {
            "api": "application",
            "variablesTransform": "$",
            "query": "query ($orderLineReleaseIds: [String!]!) {\r\n  orderLineRelease(\r\n    where: { id: { _in: $orderLineReleaseIds } }\r\n  ) {\r\n    edges {\r\n      node {\r\n        id\r\n        number\r\n        orderLine { orderId }\r\n        quantity { value }\r\n        quantityLeft { value }\r\n      }\r\n    }\r\n  }\r\n}",
            "nextNodes": [
              "36567ee1-c543-475f-8ed5-df705d0be35a"
            ]
          },

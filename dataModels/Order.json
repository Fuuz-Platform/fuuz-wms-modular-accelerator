{
  "header": {
    "id": "order",
    "name": "Order",
    "description": "Data change set for 90 days by default, changes to the orders should only be initiated from the external ERP system or via other mechnisms and typically not done manually via Fuuz - however, if you do make manual changes, those changes will be tracked for 90 days unless this setting is modified.\n\nDeleting an Order, will delete the line and release - providing no other transactions have been performed.",
    "dataModelKindId": "reference",
    "_customFields": {
      "_externalId": null
    }
  },
